GEMINI_API_KEY=your_gemini_api_key_here
FEMIS_USERNAME=your_femis_username
FEMIS_PASSWORD=your_femis_password
GOOGLE_SHEETS_CREDENTIALS=path/to/service_account.json
GOOGLE_FORMS_SPREADSHEET_ID=your_spreadsheet_id_here

# Phase 3B.4 bot-job API — leave empty to disable (endpoints fail closed).
# Never commit real values; .env is gitignored.
FEMIS_BOT_TOKEN=
FEMIS_OPERATOR_TOKEN=
# Bot-side API base URL (Phase 3B.5 --jobs mode):
FEMIS_JOB_API_URL=http://127.0.0.1:5000
# Runtime lease policy (development defaults, not design constants):
FEMIS_JOB_LEASE_SECONDS=60
FEMIS_JOB_HEARTBEAT_SECONDS=15
